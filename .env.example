# Copy to .env and fill in. The server reads .env from its working directory;
# real environment variables take precedence.

PORT=8080
# "production" turns on Secure cookies (needs HTTPS).
APP_ENV=development
# Absolute origin, used for og:image links.
PUBLIC_URL=http://localhost:8080
# Set to true only behind a reverse proxy (nginx) that sets X-Forwarded-For.
TRUST_PROXY=false

DATABASE_URL=postgres://USER:PASSWORD@10.8.0.1:5432/my_portfolio?sslmode=disable

# Garage (S3-compatible). Needs a Garage key (GK...) with read+write on the bucket:
#   garage key create my-portfolio
#   garage bucket create my-portfolio
#   garage bucket allow --read --write --owner my-portfolio --key my-portfolio
S3_ENDPOINT=http://10.8.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Must match Garage's s3_region (garage.toml).
S3_REGION=us-east-1
S3_BUCKET=my-portfolio

# The dashboard lives at this path. Anything unguessable; never /api or /media.
ADMIN_PATH=/console-change-me
# Used once, to create the admin account on first start. Change the password
# from the dashboard afterwards; this value is then ignored.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=at-least-10-characters
# openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=72

# ── Job Hunter ───────────────────────────────────────────────────────────────
# Seals stored AI keys and portal sessions. openssl rand -hex 32. Every
# process that runs the server or the worker needs the same value.
JOBS_SECRET_KEY=
# "embedded": the server also runs the browser worker (needs Chrome on this
# machine). "off": run `portfolio worker` separately, e.g. on a home machine.
JOBS_WORKER=embedded
# Shown in the dashboard and Telegram; defaults to the hostname.
JOBS_WORKER_NAME=
# Chrome profile the worker keeps sessions in.
JOBS_BROWSER_DIR=
# Chrome binary; empty = find Google Chrome / Chromium automatically.
JOBS_BROWSER_BIN=
JOBS_BROWSER_HEADLESS=true

